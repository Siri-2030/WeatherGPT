# ==============================================================================
# WeatherGPT - Frontend (Streamlit) Dockerfile
# ==============================================================================
FROM python:3.11-slim

WORKDIR /app

# ffmpeg is required by pydub (browser webm/ogg audio -> wav for speech-to-text)
RUN apt-get update && apt-get install -y --no-install-recommends gcc ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-frontend.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-frontend.txt

# BUILD-TIME SANITY CHECK: fail the build (not the live app) if PyArrow or the
# mic component is missing/broken. This is the exact import Streamlit performs
# before it renders any custom component.
RUN python -c "import pyarrow, streamlit; from streamlit.components.v1 import component_arrow; import streamlit_mic_recorder; print('OK pyarrow', pyarrow.__version__, '| streamlit', streamlit.__version__)"

COPY app.py voice_engine.py ./
COPY .streamlit ./.streamlit

RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1 \
    PORT=8501
EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD python -c "import os,requests; requests.get('http://localhost:%s/_stcore/health' % os.getenv('PORT','8501'), timeout=4).raise_for_status()" || exit 1

CMD ["sh", "-c", "streamlit run app.py --server.port=${PORT:-8501} --server.address=0.0.0.0"]
