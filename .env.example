# ==============================================================================
# WeatherGPT environment configuration
# Copy this file to `.env` and fill in your own values.
# ==============================================================================

# --- LLM provider selection ---
# "gemini" = Google Gemini free API tier (needs GOOGLE_API_KEY, get one free at
#            https://aistudio.google.com/apikey -- no credit card required)
# "ollama" = fully local, fully offline, zero-cost open-weight model
LLM_PROVIDER=gemini

# --- Gemini settings (only needed if LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_free_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama settings (only needed if LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend -> Backend wiring ---
BACKEND_URL=http://localhost:8000
