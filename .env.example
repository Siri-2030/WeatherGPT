# ==============================================================================
# WeatherGPT environment configuration
# Copy to `.env` (local / docker-compose) or paste into Render's Environment tab.
# NEVER commit the real .env file.
# ==============================================================================

# --- LLM provider -------------------------------------------------------------
#   groq   = Groq primary (+ Gemini fallback if GOOGLE_API_KEY is set)   <- recommended
#   gemini = Google Gemini only
#   ollama = fully local / offline model
LLM_PROVIDER=groq

# --- Groq (free key: https://console.groq.com/keys) ---------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (free key: https://aistudio.google.com/apikey) --------------------
GOOGLE_API_KEY=your_gemini_api_key_here
# Only used as the FALLBACK model. Google retires old ids (gemini-2.0-flash is
# already shut down) - check https://ai.google.dev/gemini-api/docs/models if this
# ever starts returning "model not found". gemini-3.8-flash is the newest Flash.
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama (only if LLM_PROVIDER=ollama) ---------------------------------------
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend -> backend wiring (set on the FRONTEND service) -------------------
#   local:           http://localhost:8000
#   docker-compose:  http://backend:8000   (set automatically)
#   Render:          https://<your-backend-service>.onrender.com   (no trailing slash)
BACKEND_URL=http://localhost:8000

# --- Optional ---------------------------------------------------------------------
# ALLOWED_ORIGINS=https://<your-frontend>.onrender.com
# WHISPER_MODEL_SIZE=base
